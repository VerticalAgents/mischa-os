{
  "manifest_version": 3,
  "name": "Mischa OS no WhatsApp",
  "description": "Mostra os dados do cliente no Mischa OS ao lado da conversa do WhatsApp Web. Só lê e escreve na caixa de digitação; não envia mensagem.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://ttguzgouurqopeccvzve.supabase.co/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mischa OS"
  }
}
